# GEMINI_API_KEY: Required for Gemini AI & Gemini Live API (Pipeline B) on the Node.js server.
# AI Studio automatically injects this at runtime from Settings > Secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DEEPGRAM_API_KEY: Required for Pipeline A (Deepgram Nova-3 live streaming STT).
DEEPGRAM_API_KEY=""

# GROQ_API_KEY: Required for Pipeline A (Groq llama-3.3-70b-versatile ultra-low-latency streaming).
GROQ_API_KEY=""

# OPENAI_API_KEY: Optional. When set on the server, fallback REST transcription/chat uses OpenAI.
OPENAI_API_KEY=""

# APP_URL: The public URL where this server is hosted.
APP_URL="MY_APP_URL"

# VITE_WINDOWS_EXE_URL: Direct download URL for the Crackpilot Windows installer (.exe).
VITE_WINDOWS_EXE_URL="https://github.com/virender18489/crackpilot/releases/latest/download/Crackpilot-Setup.exe"

# VITE_API_BASE_URL: Optional public Node.js backend URL (e.g. https://your-backend.onrender.com or http://localhost:3000).
# Leave empty for static Vercel web hosting or standalone Electron auth mode.
# Do NOT set this to an auth-walled ais-pre-*.run.app preview URL.
VITE_API_BASE_URL=""

# Super-Admin Panel (/admin) Owner-Only Credentials (server-side only, never exposed to client)
ADMIN_EMAIL=""
ADMIN_USERNAME=""
ADMIN_PASSWORD=""

