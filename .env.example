# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Optional. When set on the server (or when running the
# exported Node.js + Python kit locally), requests use OpenAI Whisper & GPT-4o-mini.
OPENAI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_WINDOWS_EXE_URL: Direct download URL for the Crackpilot Windows installer (.exe).
VITE_WINDOWS_EXE_URL="https://github.com/virender18489/crackpilot/releases/latest/download/Crackpilot-Setup.exe"

# VITE_API_BASE_URL: Backend server URL used by the packaged Electron Windows .exe app.
VITE_API_BASE_URL="https://ais-pre-xd2kveu6r7j7jhuqh3qugu-628952540927.asia-southeast1.run.app"
